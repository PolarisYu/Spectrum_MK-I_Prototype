      break;
    case 'K':
      dacFilter = 5;
      SetFilter(ak4493);
      #ifdef DUALMONO
        SetFilter(ak4493r);
      #endif //DUALMONO
      break;
    case 'M':
      soundMode = 1;
      SetSoundMode(ak4493);      
      #ifdef DUALMONO
        SetSoundMode(ak4493r);
