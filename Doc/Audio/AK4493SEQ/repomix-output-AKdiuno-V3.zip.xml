      PrintDebugReg(ak4493);
      break;
    case 'Q':
      SetMCLK(1);
      dispMain(false);
      break;
    case 'W':
      SetMCLK(2);
      dispMain(false);
      break;
    case 'E':
      SetMCLK(3);
      dispMain(false);
      break;
    case 'R':
      SetMCLK(4);
      dispMain(false);
      break;
    case 'T':
      SetMCLK(5);
      dispMain(false);
      break;
    case 'Y':
      SetMCLK(6);
      dispMain(false);
      break;
    case 'U':
      SetMCLK(7);
      dispMain(false);
      break;
    case 'I':
      SetMCLK(8);
      dispMain(false);
      break;
    case 'O':
